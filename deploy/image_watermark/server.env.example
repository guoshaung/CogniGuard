# Copy values into a host-managed environment file outside the repository.
# This example intentionally contains no registry secret.

SCE_LOCGUARD_PROJECT_ROOT=/shared/CogniGuard
SCE_LOCGUARD_OUTPUT_DIR=/shared/CogniGuard/var/outputs/sce_locguard_jobs
# Standalone API defaults only. Formal and pilot runners override both paths
# with run-local directories so registry state cannot leak across runs.
SCE_LOCGUARD_API_JOB_ROOT=/shared/CogniGuard/var/outputs/sce_locguard_api_jobs
SCE_LOCGUARD_REGISTRY_DIR=/shared/CogniGuard/var/outputs/sce_locguard_registry
COGNIGUARD_SHARED_ROOT=/shared

# The startup scripts read this mode-0600 file and export only its content to
# the API process. Keep the file outside the checkout and backups of source.
SCE_LOCGUARD_REGISTRY_SECRET_FILE=/run/secrets/cogniguard_registry_secret

HF_HOME=/shared/model_cache/hf
TORCH_HOME=/shared/model_cache/torch
SCE_LOCGUARD_INPAINT_MODEL_ID=stable-diffusion-v1-5/stable-diffusion-inpainting
# Required for the final lock file; set to the staged snapshot commit hash.
SCE_LOCGUARD_INPAINT_MODEL_REVISION=
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_HUB_DISABLE_TELEMETRY=1
COGNIGUARD_WATERMARK_ASSET_MANIFEST=/shared/CogniGuard/deploy/image_watermark/assets.manifest.example.json
COGNIGUARD_WATERMARK_BENCHMARK_CONFIG=/shared/CogniGuard/protection/image_watermark/configs/paper_benchmark.yaml

# Optional override when dataset roots are not already provided by the YAML.
# COGNIGUARD_DATASET_ROOTS_JSON={"cogniguard_edufig":"/shared/CogniGuard/data/image_watermark/cogniguard_edufig"}

SCE_LOCGUARD_DETERMINISTIC=true
# Frozen on the development split before any reported test run. The raw mask
# remains unfiltered; the area threshold controls only the coarse alert label.
SCE_LOCGUARD_RECOVERY_THRESHOLD=0.28
SCE_LOCGUARD_TAMPER_AREA_THRESHOLD=0.001
# 0 disables spatial filtering. The v3 paper protocol sets and freezes 0.005.
SCE_LOCGUARD_LOCALIZATION_MIN_COMPONENT_AREA_RATIO=0
SCE_LOCGUARD_MAX_INFLIGHT=2
CUBLAS_WORKSPACE_CONFIG=:4096:8
PYTHONHASHSEED=20260802
# For a direct non-Slurm launch you may set CUDA_VISIBLE_DEVICES=0 here.
# Do not override the value assigned by Slurm on a cluster.
TOKENIZERS_PARALLELISM=false
PYTHONUNBUFFERED=1
OMP_NUM_THREADS=8
MKL_NUM_THREADS=8

WATERMARK_API_HOST=127.0.0.1
WATERMARK_API_PORT=8010
WATERMARK_API_LOG_LEVEL=info
PYTHON_BIN=/shared/CogniGuard/.venv-server/bin/python

# A complete paper benchmark includes real diffusion attacks and therefore
# requires the offline inpainting cache. Set to 0 only for embed/verify service
# bring-up, never to relabel a partial run as a full result.
REQUIRE_AIGC_CACHE=1
REQUIRE_SHARED_ROOT=1
REQUIRE_DATASET_MANIFEST=0
RUN_PREFLIGHT=1

# Formal Slurm benchmark breadth gates.
MIN_DATASET_SAMPLES=500
MIN_TEST_SAMPLES=500
MIN_SOURCE_DATASETS=4
MIN_CONTENT_DOMAINS=4
