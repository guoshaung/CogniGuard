# 复制为 .env 后填写。禁止提交 .env。
# 用户指定：用 xAI Grok 跑复刻（非 DeepSeek-V3.2）
#
# 若此文件不存在，scripts/run_crossep_tool_phase1.sh 会改读
# ~/.grok/auth.json，并把端点设为 https://cli-chat-proxy.grok.com/v1、
# 模型设为 grok-4.7。2026-11-20 的烟雾走的是这条回退。
# 不要把 auth.json 或会话 token 复制进仓库。

LLM_BACKEND=xai
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
# 控制台精确 id。2026-11-20 烟雾锁定为 grok-4.7。
# 公开模型页没有 grok-2-latest。驱动拒绝空值和 grok-2-latest。
XAI_MODEL=grok-4.7
# 仅 CLI 代理需要。缺省 1.0.89。
XAI_CLI_VERSION=1.0.89

# 若旧脚本仍读取下列变量名，由适配层/包装脚本映射到 xAI（不要填真实 DeepSeek key 除非你真用 DeepSeek）
# DEEPSEEK_API_KEY=
# BATCH_MODEL=
# ARK_API_KEY=
