COGNIGUARD_RUNTIME_MODE=mock
COGNIGUARD_NEMO_GUARDRAILS_ENABLED=false
MIMO_API_KEY=your_mimo_api_key_here
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.5-pro
MIMO_TIMEOUT_SECONDS=60
MIMO_TEMPERATURE=0.2
MIMO_MAX_TOKENS=700
NARRA_IMAGE_BASE_URL=https://narralucky.c0ffee.space/v1
NARRA_IMAGE_API_KEY=your_narra_image_api_key_here
NARRA_IMAGE_RESPONSE_FORMAT=url
NARRA_IMAGE_TIMEOUT_SECONDS=120
# Optional: set only if your image provider requires an explicit model name.
NARRA_IMAGE_MODEL=
COGNIGUARD_IMAGE_WATERMARK_PROVIDER=auto
SCE_LOCGUARD_BASE_URL=http://127.0.0.1:8010
SCE_LOCGUARD_OUTPUT_DIR=outputs/sce_locguard_jobs
SCE_LOCGUARD_TIMEOUT_SECONDS=180
