# 复制为 .env 后填写。禁止提交 .env。
# 用户指定：用 xAI Grok 跑复刻（非 DeepSeek-V3.2）

LLM_BACKEND=xai
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
# 开跑前改成控制台里的精确模型 id，并写回 R_PREREG.md。
# 2026-11-20 公开模型页没有 grok-2-latest。示例 id：grok-4.3、grok-4.7、grok-build-0.1。
# 留空。驱动脚本拒绝空值和 grok-2-latest。
XAI_MODEL=

# 若旧脚本仍读取下列变量名，由适配层/包装脚本映射到 xAI（不要填真实 DeepSeek key 除非你真用 DeepSeek）
# DEEPSEEK_API_KEY=
# BATCH_MODEL=
# ARK_API_KEY=
