COGNIGUARD_RUNTIME_MODE=mock
COGNIGUARD_NEMO_GUARDRAILS_ENABLED=false
# Native NeMo IORails at the mandatory gateway (separate from legacy adapter).
# Requires the optional nemo extra and the built-in local config.
COGNIGUARD_NEMO_NATIVE=off
# Optional Colang dialog, candidate retrieval and agent/image pre-execution gates.
COGNIGUARD_NEMO_COLANG=off
# Synthetic-only local field-consent demonstration; never enable for real profiles.
COGNIGUARD_PROFILE_CONSENT_DEMO=off
# Optional model-backed NeMo self-check; local service only, no model auto-start.
COGNIGUARD_NEMO_SEMANTIC=off
COGNIGUARD_NEMO_SEMANTIC_URL=http://127.0.0.1:11434/v1
COGNIGUARD_NEMO_SEMANTIC_MODEL=
# Optional metrics-only observability. Disabled unless explicitly enabled here;
# LANGSMITH_TRACING alone never enables CogniGuard exports.
COGNIGUARD_LANGSMITH_ENABLED=false
COGNIGUARD_LANGSMITH_PROJECT=cogniguard-langgraph
# CogniGuard values take precedence over standard LANGSMITH_PROJECT/ENDPOINT.
COGNIGUARD_LANGSMITH_ENDPOINT=
LANGSMITH_PROJECT=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
MIMO_API_KEY=your_mimo_api_key_here
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.5-pro
MIMO_TIMEOUT_SECONDS=60
MIMO_TEMPERATURE=0.2
MIMO_MAX_TOKENS=700
NARRA_IMAGE_BASE_URL=https://narralucky.c0ffee.space/v1
NARRA_IMAGE_API_KEY=your_narra_image_api_key_here
NARRA_IMAGE_RESPONSE_FORMAT=url
NARRA_IMAGE_TIMEOUT_SECONDS=120
# Optional: set only if your image provider requires an explicit model name.
NARRA_IMAGE_MODEL=
COGNIGUARD_IMAGE_WATERMARK_PROVIDER=auto
# Set provider=paper (or strict=true) for thesis experiments. In that mode,
# unavailable real embed/verify/attack stages fail instead of using a fallback.
COGNIGUARD_IMAGE_WATERMARK_STRICT=false
SCE_LOCGUARD_BASE_URL=http://127.0.0.1:8010
SCE_LOCGUARD_PROJECT_ROOT=.
SCE_LOCGUARD_OUTPUT_DIR=var/outputs/sce_locguard_jobs
# API-internal jobs and source registry. Back up REGISTRY_DIR together with the
# registry secret; changing either breaks authentication of previously embedded images.
SCE_LOCGUARD_API_JOB_ROOT=var/outputs/sce_locguard_api_jobs
SCE_LOCGUARD_REGISTRY_DIR=var/outputs/sce_locguard_registry
SCE_LOCGUARD_TIMEOUT_SECONDS=180
# Required on the paper server. Generate a long random value and do not commit it.
SCE_LOCGUARD_REGISTRY_SECRET=
# Required for thesis runs; API requests must also carry explicit seeds.
SCE_LOCGUARD_DETERMINISTIC=false
# Frozen on dev before test: raw localization threshold and coarse alert-area gate.
SCE_LOCGUARD_RECOVERY_THRESHOLD=0.28
SCE_LOCGUARD_TAMPER_AREA_THRESHOLD=0.001
# 0 disables spatial filtering. The v3 paper protocol sets and freezes 0.005.
SCE_LOCGUARD_LOCALIZATION_MIN_COMPONENT_AREA_RATIO=0
SCE_LOCGUARD_MAX_INFLIGHT=2
CUBLAS_WORKSPACE_CONFIG=:4096:8
PYTHONHASHSEED=20260802
# Keep the Hugging Face snapshot and API registry/output volumes persistent.
HF_HOME=assets/models/hf_cache
TORCH_HOME=assets/models/torch_cache
SCE_LOCGUARD_INPAINT_MODEL_ID=stable-diffusion-v1-5/stable-diffusion-inpainting
# Pin an exact Hugging Face commit hash for formal runs.
SCE_LOCGUARD_INPAINT_MODEL_REVISION=
